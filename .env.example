# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Database (required) ---
# Neon serverless Postgres connection string.
# Create a free database at https://neon.tech and copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (required) ---
# Secret used to sign session JWTs. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# --- Rate limiting (optional in dev, recommended in prod) ---
# Upstash Redis REST credentials, used to rate-limit auth and write endpoints.
# Create a free database at https://upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
